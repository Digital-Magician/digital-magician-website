# Database (added automatically by the Vercel Neon integration)
DATABASE_URL=

# File storage for Aadhaar cards and payment screenshots
BLOB_READ_WRITE_TOKEN=

# 32-byte base64 key that encrypts Aadhaar cards and payment screenshots at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=

# Set to 1 when BLOB_READ_WRITE_TOKEN points at a private Blob store
BLOB_PRIVATE_STORE=

# Signs portal sessions and enrollment claim tokens. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Razorpay (dashboard > Settings > API keys, and Settings > Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# UPI id shown on the enrollment form
NEXT_PUBLIC_UPI_ID=GARVFENCER@YBL
